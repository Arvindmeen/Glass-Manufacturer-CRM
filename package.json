{
  "name": "glass-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build": "node scripts/check-secrets.mjs && tsc -b && vite build && node scripts/check-secrets.mjs",
    "lint": "oxlint",
