# ==============================================================
# Serverless Authentication Secret (Vercel Server Environment Variable)
# Configure this in Vercel: Project Settings -> Environment Variables
# This secret is strictly server-side and NEVER exposed to the browser.
# ==============================================================
GATE_SECRET=CRM-secure-password-here-gvdjwe

# (Optional) Pre-computed SHA-256 hash if storing hash instead of plaintext on server
# GATE_PASSWORD_HASH=

# ==============================================================
# Client Fallback (Optional for offline static development)
# ==============================================================
VITE_GATE_PASSWORD_HASH=hbhjdvhjbwduedjhewdedyue

